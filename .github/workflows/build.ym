name: Build (unsigned)

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4

      - name: Install XcodeGen
        run: brew install xcodegen

      - name: Generate Xcode project
        run: xcodegen generate

      - name: Build for device (no signing)
        run: |
          set -o pipefail
          xcodebuild \
            -project ZedSecureiOS.xcodeproj \
            -scheme ZedSecureiOS \
            -configuration Release \
            -sdk iphoneos \
            -derivedDataPath build \
            CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY="" \
            build | tee build.log

      - name: Package unsigned IPA
        run: |
          mkdir -p out/Payload
          cp -R build/Build/Products/Release-iphoneos/ZedSecureiOS.app out/Payload/
          (cd out && zip -qry ZedSecureiOS-unsigned.ipa Payload)

      - uses: actions/upload-artifact@v4
        with:
          name: ZedSecureiOS-unsigned-ipa
          path: out/ZedSecureiOS-unsigned.ipa

      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: build-log
          path: build.log
